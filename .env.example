# Copiar a .env y completar. El .env nunca se commitea.
# Generar secretos con: openssl rand -hex 32

# --- Base de datos ---
POSTGRES_DB=ceragen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Las contraseñas de abajo viajan dentro de URLs de conexión: usar solo
# caracteres seguros para URL (openssl rand -hex 32 lo cumple).
# Rol dueño del esquema: lo usan solo las migraciones
DB_OWNER_PASSWORD=
# Rol de la API: mínimo privilegio, sin DELETE ni DDL
DB_APP_PASSWORD=

# --- API ---
API_PORT=8000
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Orígenes permitidos por CORS, separados por coma (dev de Vite y el web de compose)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Usuario admin de la demo: lo crea la semilla si no existe (no cambia la
# contraseña de uno existente). Contraseña de 8 a 72 caracteres.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ceragen.local
SEED_ADMIN_PASSWORD=

# --- Frontend ---
WEB_PORT=8080
# Se incrusta al compilar: cambiarla exige reconstruir la imagen web
VITE_API_URL=http://localhost:8000
