# Copiar a .env y completar. El .env nunca se commitea.
# Generar secretos con: openssl rand -hex 32

# --- Base de datos ---
POSTGRES_DB=ceragen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Rol dueño del esquema: lo usan solo las migraciones
DB_OWNER_PASSWORD=
# Rol de la API: mínimo privilegio, sin DELETE ni DDL
DB_APP_PASSWORD=

# --- API ---
API_PORT=8000
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Usuario admin de la demo (lo crean los datos semilla)
SEED_ADMIN_PASSWORD=

# --- Frontend (se incrusta al compilar) ---
VITE_API_URL=http://localhost:8000
